@model English_language_center_management_system.Models.ViewModels.Courses.CourseCreateViewModel

@{
    ViewBag.Title = "Thêm Khóa học Mới";
}

<h2 class="my-4">Thêm Khóa học Mới</h2>

@using (Html.BeginForm("Create", "Courses", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="card shadow-sm col-md-8 offset-md-2 mb-5">
        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="mb-3">
                @Html.LabelFor(model => model.CourseName, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(model => model.CourseName, new { @class = "form-control", placeholder = "Ví dụ: Tiếng Anh Giao Tiếp Căn Bản" })
                @Html.ValidationMessageFor(model => model.CourseName, "", new { @class = "text-danger" })
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Level, new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(model => model.Level, new List<SelectListItem>
                    {
                        new SelectListItem { Text = "-- Chọn cấp độ --", Value = "" },
                        new SelectListItem { Text = "Beginner (Cơ bản)", Value = "Beginner" },
                        new SelectListItem { Text = "Intermediate (Trung cấp)", Value = "Intermediate" },
                        new SelectListItem { Text = "Advanced (Nâng cao)", Value = "Advanced" },
                        new SelectListItem { Text = "IELTS", Value = "IELTS" },
                        new SelectListItem { Text = "TOEIC", Value = "TOEIC" }
                    }, new { @class = "form-select form-control" })
                    @Html.ValidationMessageFor(model => model.Level, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Duration, new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(model => model.Duration, new { @class = "form-control", type = "number", placeholder = "Nhập số giờ học (ví dụ: 45)" })
                    @Html.ValidationMessageFor(model => model.Duration, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.TuitionFee, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(model => model.TuitionFee, new { @class = "form-control", type = "number", step = "10000", placeholder = "Nhập mức học phí (VNĐ)" })
                @Html.ValidationMessageFor(model => model.TuitionFee, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Description, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "3", placeholder = "Mô tả ngắn gọn về khóa học..." })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Syllabus, new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(model => model.Syllabus, new { @class = "form-control", rows = "4", placeholder = "Chi tiết khung chương trình đào tạo..." })
                @Html.ValidationMessageFor(model => model.Syllabus, "", new { @class = "text-danger" })
            </div>

            <div class="mt-4 text-end">
                <a href="@Url.Action("AdminIndex", "Courses")" class="btn btn-secondary me-2">Hủy bỏ</a>
                <button type="submit" class="btn btn-success">Lưu Khóa Học</button>
            </div>
        </div>
    </div>
}