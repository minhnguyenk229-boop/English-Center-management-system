
@model English_language_center_management_system.Models.ViewModels.Payments.PaymentEditViewModel

@using System
@using System.Collections.Generic
@using System.Web.Mvc

@{
    ViewBag.Title = "Sửa phiếu thu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var enrollmentOptions =
        ViewBag.EnrollmentId as IEnumerable<SelectListItem>
        ?? new List<SelectListItem>();

    var currentEnrollmentId =
        Model != null ? Model.EnrollmentId.ToString() : "";

    var selectedMethod =
        Model != null && !String.IsNullOrWhiteSpace(Model.PaymentMethod)
        ? Model.PaymentMethod
        : "Cash";

    var selectedStatus =
        Model != null && !String.IsNullOrWhiteSpace(Model.PaymentStatus)
        ? Model.PaymentStatus
        : "Paid";

    var methodOptions = new List<SelectListItem>
{
        new SelectListItem
        {
            Value = "Cash",
            Text = "Tiền mặt"
        },
        new SelectListItem
        {
            Value = "Bank Transfer",
            Text = "Chuyển khoản"
        },
        new SelectListItem
        {
            Value = "Credit Card",
            Text = "Thẻ tín dụng"
        }
    };

    var statusOptions = new List<SelectListItem>
{
        new SelectListItem
        {
            Value = "Paid",
            Text = "Đã thanh toán đủ"
        },
        new SelectListItem
        {
            Value = "Partial",
            Text = "Thanh toán một phần"
        },
        new SelectListItem
        {
            Value = "Pending",
            Text = "Chờ thanh toán"
        },
        new SelectListItem
        {
            Value = "Completed",
            Text = "Hoàn tất"
        }
    };
}

<div class="admin-payment-edit-page">

    <!-- Header -->
    <div class="payment-edit-header">
        <div>
            <div class="payment-edit-eyebrow">
                QUẢN LÝ TÀI CHÍNH
            </div>

            <h2>Sửa phiếu thu</h2>

            <p>
                Cập nhật thông tin giao dịch và kiểm tra dữ liệu
                trước khi lưu thay đổi.
            </p>
        </div>

        <div class="payment-edit-header-icon">
            <i class="glyphicon glyphicon-edit"></i>
        </div>
    </div>

    <!-- Main card -->
    <div class="payment-edit-card">

        <div class="payment-edit-card-heading">
            <div class="payment-edit-section-icon">
                <i class="glyphicon glyphicon-credit-card"></i>
            </div>

            <div>
                <h3>Phiếu thu #@Model.Id</h3>
                <p>Thông tin giao dịch thanh toán học phí.</p>
            </div>

            <span class="payment-edit-record-id">
                MÃ #@Model.Id
            </span>
        </div>

        @using (Html.BeginForm(
            "Edit",
            "Payments",
            FormMethod.Post,
            new { @class = "payment-edit-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            @Html.ValidationSummary(
                false,
                "",
                new { @class = "payment-edit-validation" }
            )

            <div class="payment-edit-grid">

                <!-- Enrollment -->
                <div class="payment-edit-group payment-edit-full">
                    @Html.LabelFor(
                        m => m.EnrollmentId,
                        "Học viên và lớp học *",
                        new { @class = "payment-edit-label" }
                    )

                    <select id="EnrollmentId"
                            name="EnrollmentId"
                            class="payment-edit-control">

                        <option value="">
                            -- Chọn học viên và lớp học --
                        </option>

                        @foreach (var option in enrollmentOptions)
                        {
                            if (option.Value == currentEnrollmentId)
                            {
                                <option value="@option.Value"
                                        selected="selected">
                                    @option.Text
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text
                                </option>
                            }
                        }
                    </select>

                    @Html.ValidationMessageFor(
                        m => m.EnrollmentId,
                        "",
                        new { @class = "payment-edit-error" }
                    )

                    <small class="payment-edit-hint">
                        Lượt ghi danh hiện tại được chọn theo mã EnrollmentId.
                    </small>
                </div>

                <!-- Amount -->
                <div class="payment-edit-group">
                    @Html.LabelFor(
                        m => m.AmountPaid,
                        "Số tiền thanh toán (VNĐ) *",
                        new { @class = "payment-edit-label" }
                    )

                    @Html.TextBoxFor(
                        m => m.AmountPaid,
                        new
                        {
                            @class = "payment-edit-control",
                            type = "number",
                            min = "1000",
                            max = "500000000",
                            step = "1",
                            placeholder = "Nhập số tiền"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.AmountPaid,
                        "",
                        new { @class = "payment-edit-error" }
                    )

                    <small class="payment-edit-hint">
                        Số tiền hợp lệ từ 1.000 đến 500.000.000 VNĐ.
                    </small>
                </div>

                <!-- Date -->
                <div class="payment-edit-group">
                    @Html.LabelFor(
                        m => m.PaymentDate,
                        "Ngày thanh toán *",
                        new { @class = "payment-edit-label" }
                    )

                    @Html.TextBoxFor(
                        m => m.PaymentDate,
                        "{0:yyyy-MM-ddTHH:mm}",
                        new
                        {
                            @class = "payment-edit-control",
                            type = "datetime-local",
                            required = "required"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.PaymentDate,
                        "",
                        new { @class = "payment-edit-error" }
                    )
                </div>

                <!-- Receipt -->
                <div class="payment-edit-group payment-edit-full">
                    @Html.LabelFor(
                        m => m.ReceiptNumber,
                        "Mã biên lai *",
                        new { @class = "payment-edit-label" }
                    )

                    @Html.TextBoxFor(
                        m => m.ReceiptNumber,
                        new
                        {
                            @class = "payment-edit-control",
                            maxlength = "50",
                            placeholder = "Nhập mã biên lai"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.ReceiptNumber,
                        "",
                        new { @class = "payment-edit-error" }
                    )

                    <small class="payment-edit-hint">
                        Mã biên lai cần duy nhất. Nên giữ nguyên mã hiện tại
                        nếu không có yêu cầu thay đổi.
                    </small>
                </div>

                <!-- Method -->
                <div class="payment-edit-group">
                    @Html.LabelFor(
                        m => m.PaymentMethod,
                        "Phương thức thanh toán *",
                        new { @class = "payment-edit-label" }
                    )

                    <select id="PaymentMethod"
                            name="PaymentMethod"
                            class="payment-edit-control">

                        @foreach (var option in methodOptions)
                        {
                            if (option.Value == selectedMethod)
                            {
                                <option value="@option.Value"
                                        selected="selected">
                                    @option.Text
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text
                                </option>
                            }
                        }
                    </select>

                    @Html.ValidationMessageFor(
                        m => m.PaymentMethod,
                        "",
                        new { @class = "payment-edit-error" }
                    )
                </div>

                <!-- Status -->
                <div class="payment-edit-group">
                    @Html.LabelFor(
                        m => m.PaymentStatus,
                        "Trạng thái thanh toán *",
                        new { @class = "payment-edit-label" }
                    )

                    <select id="PaymentStatus"
                            name="PaymentStatus"
                            class="payment-edit-control">

                        @foreach (var option in statusOptions)
                        {
                            if (option.Value == selectedStatus)
                            {
                                <option value="@option.Value"
                                        selected="selected">
                                    @option.Text
                                </option>
                            }
                            else
                            {
                                <option value="@option.Value">
                                    @option.Text
                                </option>
                            }
                        }
                    </select>

                    @Html.ValidationMessageFor(
                        m => m.PaymentStatus,
                        "",
                        new { @class = "payment-edit-error" }
                    )

                    <small class="payment-edit-hint">
                        Chọn trạng thái phản ánh đúng giao dịch.
                    </small>
                </div>

            </div>

            <!-- Notice -->
            <div class="payment-edit-notice">
                <i class="glyphicon glyphicon-info-sign"></i>

                <div>
                    <strong>Lưu ý khi sửa phiếu thu</strong>

                    <p>
                        Kiểm tra kỹ số tiền, ngày thanh toán và mã biên lai.
                        Mã biên lai không được trùng với giao dịch khác.
                    </p>

                    <p>
                        Controller hiện tại chưa tự đồng bộ lại trạng thái
                        ghi danh khi bạn đổi trạng thái của một giao dịch
                        đang tồn tại.
                    </p>
                </div>
            </div>

            <!-- Actions -->
            <div class="payment-edit-actions">

                <a href="@Url.Action("Index", "Payments")"
                   class="payment-edit-btn payment-edit-cancel">
                    <i class="glyphicon glyphicon-arrow-left"></i>
                    Hủy và quay lại
                </a>

                <button type="submit"
                        class="payment-edit-btn payment-edit-submit">
                    <i class="glyphicon glyphicon-floppy-disk"></i>
                    Lưu thay đổi
                </button>

            </div>
        }

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
