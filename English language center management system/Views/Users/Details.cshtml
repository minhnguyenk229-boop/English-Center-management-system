
@model English_language_center_management_system.Models.User

@{
    ViewBag.Title = "Chi tiết người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string fullName = string.IsNullOrWhiteSpace(Model.FullName)
        ? "Chưa cập nhật họ tên"
        : Model.FullName.Trim();

    string username = string.IsNullOrWhiteSpace(Model.Username)
        ? "Chưa có tên đăng nhập"
        : Model.Username;

    string roleName = Model.Role != null
        ? Model.Role.Name
        : "Chưa phân quyền";

    string roleLower = roleName.ToLowerInvariant();

    string roleClass = roleLower.Contains("admin") ||
                       roleLower.Contains("quản trị")
        ? "user-role-admin"
        : (roleLower.Contains("teacher") ||
           roleLower.Contains("giáo viên"))
            ? "user-role-teacher"
            : "user-role-student";

    string initial = string.IsNullOrWhiteSpace(fullName)
        ? "U"
        : fullName.Substring(0, 1).ToUpper();

    string email = string.IsNullOrWhiteSpace(Model.Email)
        ? "Chưa cập nhật"
        : Model.Email;

    string phone = string.IsNullOrWhiteSpace(Model.Phone)
        ? "Chưa cập nhật"
        : Model.Phone;
}

<style>
    .user-detail-page {
        padding: 24px;
        color: #243047;
    }

    .user-detail-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
    }

    .user-detail-eyebrow {
        color: #8995aa;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .user-detail-heading h1 {
        font-size: 28px;
        font-weight: 800;
        margin: 0 0 8px;
        color: #243047;
    }

    .user-detail-heading p {
        color: #8490a5;
        margin: 0;
    }

    .user-detail-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .user-detail-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 17px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none !important;
        transition: .2s ease;
    }

    .user-detail-btn-back {
        background: #fff;
        color: #526078;
        border: 1px solid #dce3ee;
    }

    .user-detail-btn-edit {
        background: #c92828;
        color: #fff;
        border: 1px solid #c92828;
    }

    .user-detail-btn-back:hover {
        background: #f5f7fb;
        color: #243047;
    }

    .user-detail-btn-edit:hover {
        background: #a91f1f;
        color: #fff;
    }

    .user-detail-identity {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        padding: 24px;
        background: #fff;
        border: 1px solid #e4eaf2;
        border-radius: 16px;
        margin-bottom: 22px;
        box-shadow: 0 4px 15px rgba(25, 42, 70, .035);
    }

    .user-detail-avatar {
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: #fff0f0;
        color: #c92828;
        font-size: 28px;
        font-weight: 800;
        flex-shrink: 0;
    }

    .user-detail-identity h2 {
        font-size: 21px;
        font-weight: 800;
        margin: 0 0 6px;
        color: #243047;
    }

    .user-detail-identity p {
        color: #8995aa;
        margin: 0;
    }

    .user-detail-role {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 800;
        margin-left: auto;
    }

    .user-role-admin {
        background: #fff0f0;
        color: #b42323;
    }

    .user-role-teacher {
        background: #eaf2ff;
        color: #245bb5;
    }

    .user-role-student {
        background: #e8f8ef;
        color: #087443;
    }

    .user-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
        margin-bottom: 22px;
    }

    .user-detail-card {
        background: #fff;
        border: 1px solid #e4eaf2;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(25, 42, 70, .035);
    }

    .user-detail-card-header {
        padding: 18px 22px;
        border-bottom: 1px solid #edf0f5;
        font-size: 16px;
        font-weight: 800;
        color: #26344c;
    }

    .user-detail-card-body {
        padding: 6px 22px;
    }

    .user-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        padding: 16px 0;
        border-bottom: 1px solid #f0f2f6;
    }

        .user-detail-row:last-child {
            border-bottom: none;
        }

    .user-detail-label {
        color: #8490a5;
        font-size: 13px;
        min-width: 120px;
    }

    .user-detail-value {
        color: #26344c;
        font-weight: 700;
        font-size: 14px;
        text-align: right;
        overflow-wrap: anywhere;
    }

    .user-detail-profile {
        background: #fff;
        border: 1px solid #e4eaf2;
        border-radius: 15px;
        padding: 22px;
        box-shadow: 0 4px 15px rgba(25, 42, 70, .035);
    }

        .user-detail-profile h3 {
            margin: 0 0 18px;
            font-size: 16px;
            font-weight: 800;
        }

    .user-detail-profile-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .user-detail-profile-item {
        padding: 15px;
        background: #f7f9fc;
        border-radius: 10px;
    }

        .user-detail-profile-item span {
            display: block;
            color: #8490a5;
            font-size: 13px;
            margin-bottom: 7px;
        }

        .user-detail-profile-item strong {
            display: block;
            color: #26344c;
            font-size: 14px;
            overflow-wrap: anywhere;
        }

    .user-detail-empty {
        color: #8490a5;
        font-size: 14px;
        margin: 0;
    }

    @@media (max-width: 768px) {
        .user-detail-page {
            padding: 15px;
        }

        .user-detail-grid,
        .user-detail-profile-grid {
            grid-template-columns: 1fr;
        }

        .user-detail-role {
            margin-left: 0;
        }

        .user-detail-row {
            flex-direction: column;
            gap: 7px;
        }

        .user-detail-value {
            text-align: left;
        }
    }
</style>

<div class="user-detail-page">

    <div class="user-detail-heading">
        <div>
            <div class="user-detail-eyebrow">English Language Center</div>
            <h1>Chi tiết người dùng</h1>
            <p>Thông tin tài khoản và hồ sơ người dùng trong hệ thống.</p>
        </div>

        <div class="user-detail-actions">
            <a href="@Url.Action("Index", "Users")"
               class="user-detail-btn user-detail-btn-back">
                ← Quay lại danh sách
            </a>

            <a href="@Url.Action("Edit", "Users", new { id = Model.Id })"
               class="user-detail-btn user-detail-btn-edit">
                ✎ Chỉnh sửa
            </a>
        </div>
    </div>

    <div class="user-detail-identity">
        <div class="user-detail-avatar">@initial</div>

        <div>
            <h2>@fullName</h2>
            <p>@@@username</p>
        </div>

        <span class="user-detail-role @roleClass">@roleName</span>
    </div>

    <div class="user-detail-grid">

        <section class="user-detail-card">
            <div class="user-detail-card-header">
                Thông tin cá nhân
            </div>

            <div class="user-detail-card-body">
                <div class="user-detail-row">
                    <span class="user-detail-label">Họ và tên</span>
                    <span class="user-detail-value">@fullName</span>
                </div>

                <div class="user-detail-row">
                    <span class="user-detail-label">Email</span>
                    <span class="user-detail-value">@email</span>
                </div>

                <div class="user-detail-row">
                    <span class="user-detail-label">Số điện thoại</span>
                    <span class="user-detail-value">@phone</span>
                </div>
            </div>
        </section>

        <section class="user-detail-card">
            <div class="user-detail-card-header">
                Thông tin tài khoản
            </div>

            <div class="user-detail-card-body">
                <div class="user-detail-row">
                    <span class="user-detail-label">Mã người dùng</span>
                    <span class="user-detail-value">#@Model.Id</span>
                </div>

                <div class="user-detail-row">
                    <span class="user-detail-label">Tên đăng nhập</span>
                    <span class="user-detail-value">@username</span>
                </div>

                <div class="user-detail-row">
                    <span class="user-detail-label">Vai trò</span>
                    <span class="user-detail-value">@roleName</span>
                </div>

                <div class="user-detail-row">
                    <span class="user-detail-label">Ngày tạo</span>
                    <span class="user-detail-value">
                        @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>
            </div>
        </section>

    </div>

    <section class="user-detail-profile">
        <h3>Thông tin hồ sơ</h3>

        @if (Model.StudentProfile != null)
        {
            <div class="user-detail-profile-grid">
                <div class="user-detail-profile-item">
                    <span>Địa chỉ học viên</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.StudentProfile.Address)
                            ? "Chưa cập nhật"
                            : Model.StudentProfile.Address)
                    </strong>
                </div>
            </div>
        }
        else if (Model.TeacherProfile != null)
        {
            <div class="user-detail-profile-grid">
                <div class="user-detail-profile-item">
                    <span>Chuyên môn giảng dạy</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.TeacherProfile.Specialization)
                            ? "Chưa cập nhật"
                            : Model.TeacherProfile.Specialization)
                    </strong>
                </div>
            </div>
        }
        else
        {
            <p class="user-detail-empty">
                Tài khoản chưa có hồ sơ học viên hoặc giáo viên liên kết.
            </p>
        }
    </section>

</div>
